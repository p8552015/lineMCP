# LINE MCP Bot 環境變數模板
# 複製此檔案為 .env.dev、.env.staging、.env.prod 並填入實際值

# =============================================================================
# 基本配置
# =============================================================================

# 環境名稱 (development/staging/production)
ENVIRONMENT=development

# 日誌級別 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# =============================================================================
# LINE Bot 配置
# =============================================================================

# LINE Channel Access Token (必填)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE Channel Secret (必填)
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Bot Webhook URL (可選，用於設置 webhook)
LINE_WEBHOOK_URL=https://your-domain.com/webhook

# =============================================================================
# AI 模型配置
# =============================================================================

# AI 模型提供商 (google/openai)
AI_MODEL_PROVIDER=google

# Google Gemini API Key (推薦)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (備用)
OPENAI_API_KEY=your_openai_api_key_here

# AI 模型設定
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# =============================================================================
# 資料庫配置
# =============================================================================

# PostgreSQL 配置 (生產環境)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=line_mcp
POSTGRES_USER=line_mcp
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_URL=postgresql://line_mcp:password@localhost:5432/line_mcp

# PostgreSQL 複製配置 (生產環境)
POSTGRES_REPLICATION_PASSWORD=your_replication_password_here

# =============================================================================
# Redis 配置
# =============================================================================

# Redis 連接配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Redis 連接池設定
REDIS_MAX_CONNECTIONS=10
REDIS_RETRY_ON_TIMEOUT=true

# =============================================================================
# MCP 服務器配置
# =============================================================================

# SQLite MCP 服務器
MCP_SQLITE_SERVER_URL=stdio://npx @mcp/sqlite
MCP_SQLITE_DB_PATH=./data/sqlite/test.db

# MCP 連接設定
MCP_CONNECTION_TIMEOUT=30
MCP_MAX_RETRIES=3
MCP_HEALTH_CHECK_INTERVAL=30

# =============================================================================
# 系統配置
# =============================================================================

# macOS 修復 (必需在 macOS 上)
ASYNCIO_FORCE_SELECT_SELECTOR=1

# 伺服器配置
HOST=0.0.0.0
PORT=8000
WORKERS=1

# 請求限制
MAX_REQUEST_SIZE=10485760  # 10MB
REQUEST_TIMEOUT=30

# =============================================================================
# 監控與可觀測性
# =============================================================================

# Prometheus 指標
METRICS_ENABLED=true
METRICS_PORT=9000

# OpenTelemetry 追蹤
TRACING_ENABLED=true
OTEL_SERVICE_NAME=line-mcp-bot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry 錯誤追蹤 (生產環境)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=${ENVIRONMENT}

# New Relic 監控 (可選)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here
NEW_RELIC_APP_NAME=LINE-MCP-Bot-${ENVIRONMENT}

# =============================================================================
# 安全設定
# =============================================================================

# JWT 設定 (如果需要)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# API 金鑰 (內部 API)
API_SECRET_KEY=your_api_secret_key_here

# CORS 設定
CORS_ORIGINS=["https://your-domain.com"]
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# 備份與恢復
# =============================================================================

# 備份設定
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # 每日凌晨2點
BACKUP_RETENTION_DAYS=30

# S3 備份配置 (生產環境)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_REGION=us-west-2

# =============================================================================
# 第三方服務
# =============================================================================

# Slack 通知 (告警)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#alerts

# Email 通知 (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_here
SMTP_TLS=true

# =============================================================================
# 開發工具 (僅開發環境)
# =============================================================================

# 熱重載
RELOAD=true

# 調試設定
DEBUG=true
DEBUG_PORT=5678

# 測試設定
TEST_DATABASE_URL=sqlite:///./test.db
TEST_REDIS_URL=redis://localhost:6379/15

# =============================================================================
# 效能調優
# =============================================================================

# 快取設定
CACHE_TTL=300  # 5分鐘
CACHE_MAX_SIZE=1000

# 連接池設定
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# 工作程序設定
WORKER_PROCESSES=1
WORKER_THREADS=4
WORKER_TIMEOUT=30

# =============================================================================
# Feature Flags
# =============================================================================

# 功能開關
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_EXPERIMENTAL_AI=false
FEATURE_BETA_FEATURES=false

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # 秒

# =============================================================================
# SSL/TLS 配置 (生產環境)
# =============================================================================

# SSL 憑證路徑
SSL_CERT_PATH=/ssl/cert.pem
SSL_KEY_PATH=/ssl/key.pem

# Let's Encrypt 配置
ACME_EMAIL=admin@your-domain.com
ACME_STAGING=false

# =============================================================================
# 容器化配置
# =============================================================================

# Docker 設定
DOCKER_REGISTRY=ghcr.io
DOCKER_NAMESPACE=your-org
DOCKER_TAG=latest

# Kubernetes 設定 (如果使用)
K8S_NAMESPACE=line-mcp
K8S_CLUSTER=production

# =============================================================================
# 說明
# =============================================================================

# 1. 將此檔案複製為對應環境的設定檔：
#    - .env.dev (開發環境)
#    - .env.staging (測試環境)  
#    - .env.prod (生產環境)
#
# 2. 填入實際的配置值，特別注意：
#    - LINE_CHANNEL_ACCESS_TOKEN 和 LINE_CHANNEL_SECRET 是必填項
#    - 至少配置一個 AI 模型 (Google 或 OpenAI)
#    - 生產環境務必使用強密碼和安全配置
#
# 3. 敏感資訊安全提醒：
#    - 絕不要將包含真實密碼的 .env 檔案提交到版本控制
#    - 使用密碼管理器生成強密碼
#    - 定期輪換 API 金鑰和密碼
#
# 4. 環境特定建議：
#    - 開發環境：可使用較簡單的配置，啟用調試功能
#    - 測試環境：模擬生產環境，但使用測試資料
#    - 生產環境：使用最嚴格的安全設定和監控