# ==============================================================================
# 環境變數配置模板 - LINE MCP Bot
# 複製此檔案為 .env 並填入實際值
# ==============================================================================

# ================================
# 應用基本配置
# ================================
# 應用運行環境 (development/testing/staging/production)
ENVIRONMENT=production

# 日誌級別 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 是否啟用除錯模式 (true/false)
DEBUG=false

# 工作進程數量
WORKERS=1

# 服務端口
APP_PORT=8000

# ================================
# LINE Bot 配置
# ================================
# LINE Channel Access Token (必須)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE Channel Secret (必須)
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Bot 使用者 ID (選用，用於管理員功能)
LINE_ADMIN_USER_ID=your_line_user_id

# ================================
# AI 模型配置
# ================================
# 主要 AI 模型提供商 (google/openai)
AI_MODEL_PROVIDER=google

# Google Gemini API Key (推薦)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (備用)
OPENAI_API_KEY=your_openai_api_key_here

# AI 模型配置
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ================================
# 資料庫配置
# ================================
# PostgreSQL 連接字符串
DATABASE_URL=postgresql://postgres:password@localhost:5432/line_mcp

# PostgreSQL 配置
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=line_mcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# ================================
# Redis 快取配置
# ================================
# Redis 連接字符串
REDIS_URL=redis://localhost:6379/0

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 快取過期時間（秒）
CACHE_TTL=3600

# ================================
# MCP 服務配置
# ================================
# MCP SQLite 服務器地址
MCP_SQLITE_HOST=localhost
MCP_SQLITE_PORT=3003

# MCP 連接超時設定（秒）
MCP_CONNECTION_TIMEOUT=30
MCP_READ_TIMEOUT=60

# ================================
# 安全配置
# ================================
# JWT 秘密金鑰
JWT_SECRET_KEY=your_jwt_secret_key_here

# API 存取金鑰（選用）
API_ACCESS_KEY=your_api_access_key

# 允許的來源域名（CORS）
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ================================
# 監控配置
# ================================
# Prometheus 指標端點是否啟用
ENABLE_METRICS=true

# OpenTelemetry 配置
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=line-mcp-bot

# 健康檢查配置
HEALTH_CHECK_INTERVAL=30

# ================================
# 文件儲存配置
# ================================
# 上傳文件儲存路徑
UPLOAD_DIR=/app/uploads

# 最大文件大小（MB）
MAX_FILE_SIZE=10

# 允許的文件類型
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,txt

# ================================
# 郵件配置（告警通知）
# ================================
# SMTP 服務器配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=true

# 告警郵件收件人
ALERT_EMAIL=admin@yourdomain.com

# ================================
# 外部服務配置
# ================================
# 第三方 API 配置
EXTERNAL_API_KEY=your_external_api_key
EXTERNAL_API_ENDPOINT=https://api.example.com

# Webhook 配置
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=your_webhook_secret

# ================================
# Docker 部署配置
# ================================
# Docker 相關端口映射
HTTP_PORT=80
HTTPS_PORT=443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# 域名配置
DOMAIN=yourdomain.com

# ================================
# 開發環境配置
# ================================
# 開發模式專用配置
DEV_PORT=8001
DEBUG_PORT=5678

# 測試環境配置
TEST_DATABASE_URL=sqlite:///app/data/test.db

# ================================
# macOS 特定配置
# ================================
# 修復 macOS KqueueSelector 問題
ASYNCIO_FORCE_SELECT_SELECTOR=1

# ================================
# 效能調優配置
# ================================
# 連接池大小
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 請求超時設定
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10

# 併發限制
MAX_CONCURRENT_REQUESTS=100

# ================================
# 日誌配置
# ================================
# 日誌文件路徑
LOG_FILE_PATH=/app/logs/application.log

# 日誌檔案大小限制（MB）
LOG_MAX_SIZE=100

# 日誌檔案保留數量
LOG_BACKUP_COUNT=5

# 結構化日誌格式
LOG_FORMAT=json

# ================================
# 備份與恢復配置
# ================================
# 自動備份啟用
AUTO_BACKUP_ENABLED=true

# 備份間隔（小時）
BACKUP_INTERVAL=24

# 備份保留天數
BACKUP_RETENTION_DAYS=30

# 備份儲存路徑
BACKUP_PATH=/app/backups

# ================================
# 實驗性功能配置
# ================================
# 啟用實驗性功能
ENABLE_EXPERIMENTAL_FEATURES=false

# A/B 測試配置
AB_TEST_ENABLED=false
AB_TEST_PERCENTAGE=10

# ================================
# 監控告警配置
# ================================
# Grafana 管理員密碼
GRAFANA_ADMIN_PASSWORD=admin

# AlertManager 配置
ALERTMANAGER_PORT=9093

# 告警通知配置
SLACK_API_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# ================================
# 說明
# ================================
# 1. 複製此檔案為 .env：cp .env.template .env
# 2. 填入實際的配置值，特別是標記為「必須」的項目
# 3. 確保 .env 檔案不會被提交到版本控制系統
# 4. 生產環境建議使用更強的密碼和金鑰
# 5. 定期輪換敏感資訊如 API 金鑰和密碼

# ================================
# 安全提醒
# ================================
# ⚠️ 請勿將包含真實密碼和 API 金鑰的 .env 檔案提交到 Git
# ⚠️ 生產環境請使用強密碼和隨機生成的金鑰
# ⚠️ 定期檢查和更新所有憑證
# ⚠️ 啟用必要的防火牆和安全組規則