# LINE Configuration - 請使用您自己的認證資訊
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET

# OpenAI Configuration - 請使用您自己的 API Key
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:3001
MCP_API_KEY=context7_mcp_key
CONTEXT7_MCP_URL=http://localhost:3001
POSTGRES_MCP_URL=http://localhost:3002
POSTGRES_CONNECTION_STRING=postgresql://localhost:5432/mcp_test

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# Security - 請產生強密碼
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=line-mcp-webhook
PROMETHEUS_PORT=9090

# Cost Control
MONTHLY_TOKEN_BUDGET_USD=150
TOKEN_PRICE_PER_1K_INPUT=0.01
TOKEN_PRICE_PER_1K_OUTPUT=0.03

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10