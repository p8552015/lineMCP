# 測試環境配置
# PostgreSQL 測試資料庫連接
DATABASE_URL=postgresql://admin:admin@localhost:5432/mydb

# LINE Bot 測試設定
LINE_CHANNEL_ACCESS_TOKEN=test_token_for_testing
LINE_CHANNEL_SECRET=test_secret_for_testing

# AI 模型測試設定（使用實際的API key進行CI測試）
AI_MODEL_PROVIDER=google
GOOGLE_API_KEY=${GOOGLE_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}

# JWT 測試設定
JWT_SECRET_KEY=test_jwt_secret_key_for_testing_only

# 系統設定
ASYNCIO_FORCE_SELECT_SELECTOR=1
ENVIRONMENT=test

# MCP 服務器配置
MCP_SERVER_URL=http://localhost:3003
MCP_TIMEOUT=30

# 測試專用設定
PYTEST_TIMEOUT=600
TEST_DB_CLEANUP=true
TEST_DATA_RESET=true

# 日誌設定
LOG_LEVEL=DEBUG
LOG_FORMAT=json