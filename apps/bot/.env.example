# LINE Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Google AI Configuration (Gemini - Recommended)
GOOGLE_API_KEY=your_google_api_key_here        # 15M free tokens/month
GOOGLE_MODEL=gemini-1.5-flash

# AI Model Preferences
AI_MODEL_PROVIDER=google          # google, openai, auto
AI_ENABLE_ENHANCED_NL=true        # Enable AI enhancement, but only when rule parsing fails
AI_FALLBACK_TO_RULES=true         # Always prioritize rules
AI_RULES_FIRST=true               # Explicitly specify rules first

# MCP Server Configuration
MCP_SERVER_URL=postgresql://admin:admin@localhost:5432/mydb    # PostgreSQL MCP Server
CONTEXT7_MCP_URL=http://localhost:3003                        # Context7 HTTP Server (Optional)
POSTGRES_CONNECTION_STRING=postgresql://admin:admin@localhost:5432/mydb

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# Security
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=line-mcp-webhook
PROMETHEUS_PORT=9090

# Cost Control
MONTHLY_TOKEN_BUDGET_USD=150
TOKEN_PRICE_PER_1K_INPUT=0.01
TOKEN_PRICE_PER_1K_OUTPUT=0.03

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# macOS Fix (Important)
ASYNCIO_FORCE_SELECT_SELECTOR=1   # Fix KqueueSelector hanging issue